# Django Backend Environment Configuration
SECRET_KEY=django-insecure-change-this-in-production-key-moneyflow-2026
DEBUG=True
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moneyflow_db
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.20.3,192.168.20.7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.20.3:5173,http://192.168.20.7:5173

# Email SMTP Configuration (Optional - defaults to console backend if EMAIL_HOST_USER is unset)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=MoneyFlow <your_email@gmail.com>

# Frontend Environment Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

